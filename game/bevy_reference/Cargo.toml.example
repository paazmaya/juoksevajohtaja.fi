[package]
name = "juokseva-johtaja-bevy"
version = "0.1.0"
edition = "2021"
description = "Reference Bevy implementation for Juokseva Johtaja running game"

[dependencies]
bevy = { version = "0.14", default-features = true }
bevy_parallax = "0.8"
bevy_rapier2d = { version = "0.27", features = ["simd-stable"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
