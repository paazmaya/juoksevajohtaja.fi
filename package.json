{
  "name": "juoksevajohtaja.fi",
  "version": "0.2.0",
  "private": true,
  "description": "Rust and WebAssembly web site for the running leader podcast",
  "homepage": "https://github.com/paazmaya/juoksevajohtaja.fi",
  "bugs": {
    "url": "https://github.com/paazmaya/juoksevajohtaja.fi/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Juga Paazmaya",
    "email": "paazmaya@yahoo.com",
    "url": "https://paazmaya.fi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paazmaya/juoksevajohtaja.fi.git"
  },
  "type": "commonjs",
  "scripts": {
    "build:site": "cd site && trunk build --release",
    "build:game": "cd game && trunk build --release",
    "build:prerender": "cargo run --release -p juoksevajohtaja-site --bin prerender -- dist",
    "build": "npm run build:site && npm run build:game && npm run build:prerender",
    "start": "cd site && trunk serve",
    "serve:game": "cd game && trunk serve",
    "serve": "node scripts/serve.js",
    "lint": "oxfmt --check && cargo fmt --all --check",
    "format": "oxfmt && cargo fmt --all",
    "test:cargo": "cargo test --workspace --all-targets --features juoksevajohtaja-content/parse",
    "test:coverage": "cargo llvm-cov --workspace --all-targets --features juoksevajohtaja-content/parse --fail-under-lines 95 --ignore-filename-regex \"bevy_reference|[\\\\/]src[\\\\/]main\\.rs|[\\\\/]src[\\\\/]bin[\\\\/]|[\\\\/]src[\\\\/]web\\.rs\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test": "npm run test:coverage && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "oxfmt": "0.78.0"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.0"
  }
}
