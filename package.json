{
  "name": "juoksevajohtaja.fi",
  "version": "0.1.0",
  "description": "Static web site for the running leader podcast",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:site": "npx @11ty/eleventy",
    "build:game": "cd game && trunk build --release",
    "build": "npm run build:site && npm run build:game",
    "start": "npx @11ty/eleventy --serve",
    "serve:game": "cd game && trunk serve",
    "lint": "oxfmt --check",
    "format": "oxfmt",
    "test:cargo": "cargo test --manifest-path game/Cargo.toml",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test": "npm run test:cargo && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paazmaya/juoksevajohtaja.fi.git"
  },
  "author": {
    "name": "Juga Paazmaya",
    "email": "paazmaya@yahoo.com",
    "url": "https://paazmaya.fi"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/paazmaya/juoksevajohtaja.fi/issues"
  },
  "homepage": "https://github.com/paazmaya/juoksevajohtaja.fi",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@playwright/test": "^1.50.0",
    "oxfmt": "0.70.0"
  }
}
